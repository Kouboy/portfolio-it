---
permalink: index.html
---
{% from "macros.njk" import themeMark, mascotChip %}<!doctype html>
<html lang="fr"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="description" content="Portfolio IT de Nicolas Georget : dépannage, réemploi, systèmes, réseau et outils techniques."><title>Nicolas Georget — Technical Archive</title><link rel="stylesheet" href="styles.css"><link rel="stylesheet" href="rrt4-lexicon.css"><script src="page-transition.js"></script></head><body>
{% include "header.njk" %}<main id="content">
<section class="hero"><div class="hero-main"><div class="hero-kicker meta">{{ site.hero.kicker }}</div><h1>{% for line in site.hero.title %}<span{% if not loop.first %} class="signal"{% endif %}>{{ line }}</span>{% endfor %}</h1><div class="hero-lede"><b>{{ site.hero.field_label }}</b><div>{{ site.hero.lede }}</div></div></div><aside class="hero-side"><strong>{% for line in site.hero.side_slogan %}{{ line }}{% if not loop.last %}<br>{% endif %}{% endfor %}</strong><div class="jp-big">{{ site.hero.side_jp }}</div><small>{% for line in site.hero.side_meta %}{{ line }}{% if not loop.last %}<br>{% endif %}{% endfor %}</small></aside></section>
<div class="motion-strip"><div>OBSERVE / TEST / LOCALIZE / CORRECT / RECORD / REUSE / LEARN</div><div class="right">MODE: PROJECT SELECT</div></div>
<div class="utility-band"><div class="gray">VIEW / INDEX MODE</div><div>{{ mascotChip("repair", "LOCAL DUCK / REPAIR UNIT") | safe }}</div><div class="black">→ SELECT / OPEN / READ</div></div>
<div class="utility-band"><div class="gray">LANGUAGE LAYER</div><div><span class="tri-label"><span class="en">INTERFACE</span><span class="jp">記号</span><span class="fr">FR raconte · EN structure · JP ponctue</span></span></div><div class="black">FR / EN / JP</div></div>
<section id="index"><div class="section-title"><div class="left"><div class="tri-stack"><span class="en">{{ site.chapters.index.en }}</span><span class="jp">{{ site.chapters.index.jp }}</span><span class="fr">{{ site.chapters.index.fr }}</span></div></div><div><div class="side-note cyan">{{ site.chapters.index.badge }}</div><h2>{% for line in site.chapters.index.title_lines %}{{ line }}{% if not loop.last %}<br>{% endif %}{% endfor %}</h2><p>{{ site.chapters.index.intro }}</p></div></div>
<div class="utility-band"><div class="gray">THEME KEY</div><div class="theme-key"><span class="key">{{ themeMark("repair") | safe }}REPAIR / REUSE</span><span class="key">{{ themeMark("system") | safe }}SYSTEM / NETWORK</span><span class="key">{{ themeMark("diagnostic") | safe }}DIAGNOSTIC / EVIDENCE</span><span class="key">{{ themeMark("tool") | safe }}TOOLS / MEDIATION</span></div><div class="black">THEMATIC MARKS / PROJECT FAMILIES</div></div>
<div class="project-select">{% for p in collections.project %}<a class="project-row{% if p.data.feature %} feature{% endif %}" href="{{ p.data.permalink }}"><div class="num">{{ p.data.num }}</div><div class="name">{{ p.data.display }}</div><div class="project-cat">{{ p.data.category }}</div><div class="status {{ p.data.status_class }}">{{ p.data.status }}</div><div style="display:flex;align-items:center;justify-content:flex-end;gap:8px">{{ themeMark(p.data.theme) | safe }}<span class="arrow">→</span></div></a>{% endfor %}</div></section>
<section id="protocol"><div class="section-title"><div class="left"><div class="tri-stack"><span class="en">{{ site.chapters.protocol.en }}</span><span class="jp">{{ site.chapters.protocol.jp }}</span><span class="fr">{{ site.chapters.protocol.fr }}</span></div></div><div>{{ mascotChip("diagnostic", site.chapters.protocol.badge) | safe }}<h2>{% for line in site.chapters.protocol.title_lines %}{{ line }}{% if not loop.last %}<br>{% endif %}{% endfor %}</h2><p>{{ site.chapters.protocol.intro }}</p></div></div><div class="principles">{% for p in site.principles %}<article class="principle"><div class="n">{{ p.id }}</div><h3>{{ p.title }}</h3><p>{{ p.text }}</p></article>{% endfor %}</div></section>
<section id="profile"><div class="section-title"><div class="left"><div class="tri-stack"><span class="en">{{ site.chapters.profile.en }}</span><span class="jp">{{ site.chapters.profile.jp }}</span><span class="fr">{{ site.chapters.profile.fr }}</span></div></div><div>{{ mascotChip("tool", site.chapters.profile.badge) | safe }}<h2>{% for line in site.chapters.profile.title_lines %}{{ line }}{% if not loop.last %}<br>{% endif %}{% endfor %}</h2><p>{{ site.chapters.profile.intro }}</p></div></div></section></main>
<footer class="footer"><div class="footer-main"><strong>Nicolas<br>Georget</strong><div class="footer-joke">{{ themeMark("repair") | safe }}<span><b>LOCAL DUCK / FIELD NOTE 04</b><br>Si ça marche enfin, noter pourquoi avant de toucher à autre chose.</span></div><div class="footer-languages"><span>FR / CONTENT</span><span>EN / UI</span><span class="jp">JP / 記号</span></div></div><div class="footer-side"><div>TECHNICAL ARCHIVE / {{ site.revision }}<br>修復 / 記録 / 試験</div>{{ mascotChip("system", "ARCHIVE NODE") | safe }}<div>SUN MODE / ACTIVE<br>SUN / SIGNAL / METHOD</div></div></footer><script src="rrt4-safe.js"></script><script src="rrt4-lexicon.js"></script></body></html>