{% from "macros.njk" import themeMark %}<!doctype html>
<html lang="fr"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="description" content="{{ lede }}"><title>UNIT {{ num }} — {{ display }}</title><link rel="stylesheet" href="styles.css"></head><body>
{% include "header.njk" %}
<div class="utility-band"><div class="gray">UNIT {{ num }} / {{ category }}</div><div>{{ themeMark(theme) | safe }}</div><div class="black">{{ status }}</div></div>
<main id="content"><section class="project-head"><div class="project-head-main"><div class="crumb">TECHNICAL ARCHIVE / UNIT {{ num }} / {{ category }}</div><span class="status {{ status_class }}">{{ status }}</span><h1>{{ title }}</h1><div class="lede">{{ lede }}</div><div class="lang-ribbon">{% for t in tri %}<span class="tri-label"><span class="en">{{ t.en }}</span><span class="jp">{{ t.jp }}</span><span class="fr">{{ t.fr }}</span></span>{% endfor %}</div></div><aside class="project-head-side">{% for f in facts %}<div class="fact"><small>{{ f.label }}</small>{{ f.value }}</div>{% endfor %}<div class="jp-big">{{ jp }}</div></aside></section>
<section class="project-section"><aside class="rail"><div class="num">01</div><div class="tri-stack"><span class="en">PROJECT</span><span class="jp">概要</span><span class="fr">Présentation</span></div></aside><div class="body"><div class="side-note cyan">validated project</div><h2>Project overview</h2><div class="prose"><p>{{ overview }}</p></div></div></section>
<section class="project-section" id="skills"><aside class="rail"><div class="num">02</div><div class="tri-stack"><span class="en">SKILLS</span><span class="jp">習得</span><span class="fr">Notions maîtrisées</span></div></aside><div class="body"><h2>Concrete skills</h2><div class="lesson-list">{% for s in skills %}<div class="lesson"><b>C{{ loop.index | pad2 }}</b><span>{{ s }}</span></div>{% endfor %}</div></div></section>
<section class="project-section" id="evidence"><aside class="rail"><div class="num">03</div><div class="tri-stack"><span class="en">EVIDENCE</span><span class="jp">証拠</span><span class="fr">Livrables / preuves</span></div></aside><div class="body"><h2>Evidence</h2><div class="evidence-grid">{% for e in evidence %}<div class="evidence{% if loop.first %} wide{% endif %}"><small>EVIDENCE {{ loop.index | pad2 }} / 証拠</small><strong>{{ e }}</strong></div>{% endfor %}</div></div></section>
<section class="project-section"><aside class="rail"><div class="num">04</div><div class="tri-stack"><span class="en">OUTCOME</span><span class="jp">結果</span><span class="fr">Résultat</span></div></aside><div class="body"><h2>Validated outcome</h2><div class="outcome"><strong>{{ display }}</strong><p>{{ outcome }}</p></div></div></section>
<nav class="nextbar"><a href="{{ prev.file }}"><small>← PREVIOUS UNIT</small><strong>{{ prev.name }}</strong></a><a href="{{ next.file }}"><small>NEXT UNIT →</small><strong>{{ next.name }}</strong></a></nav></main>
<footer class="footer"><div class="footer-main"><strong>UNIT {{ num }}<br>{{ display }}</strong><div class="project-footer-joke">{{ themeMark(theme) | safe }}<span><b>{{ footer_title }}</b><br>{{ footer_joke }}</span></div><div class="footer-languages"><span>FR / CONTENT</span><span>EN / UI</span><span class="jp">JP / 記号</span></div></div><div class="footer-side"><div>{{ category }}<br>{{ jp }} / VALIDATED PROJECT</div><div>{{ site.revision }} / 2026</div></div></footer><script src="rrt4-safe.js"></script></body></html>