{% from "macros.njk" import themeMark, mascotChip %}<!doctype html>
<html lang="fr"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="description" content="{{ lede }}"><title>UNIT {{ num }} — {{ display }}</title><link rel="stylesheet" href="styles.css"></head><body>
{% include "header.njk" %}
<div class="utility-band"><div class="gray">UNIT {{ num }} / {{ category }}</div><div>{{ mascotChip(theme, category) | safe }}</div><div class="black">{{ status }}</div></div>
<main id="content">
<section class="project-head"><div class="project-head-main"><div class="crumb">TECHNICAL ARCHIVE / UNIT {{ num }} / {{ category }}</div><span class="status {{ status_class }}">{{ status }}</span><h1>{{ title }}</h1><div class="lede">{{ lede }}</div><div class="lang-ribbon">{% for t in tri %}<span class="tri-label"><span class="en">{{ t.en }}</span><span class="jp">{{ t.jp }}</span><span class="fr">{{ t.fr }}</span></span>{% endfor %}</div></div>
<aside class="project-head-side">{% for f in facts %}<div class="fact"><small>{{ f.label }}</small>{{ f.value }}</div>{% endfor %}<div class="jp-big">{{ jp }}</div></aside></section>

<section class="project-section"><aside class="rail"><div class="num">01</div><div class="tri-stack"><span class="en">CONTEXT</span><span class="jp">背景</span><span class="fr">Contexte</span></div></aside><div class="body">{{ mascotChip(theme, "PROJECT THEME") | safe }}<h2>Context</h2><div class="prose"><p>{{ context }}</p></div></div></section>
<section class="project-section"><aside class="rail"><div class="num">02</div><div class="tri-stack"><span class="en">OBJECTIVE</span><span class="jp">目的</span><span class="fr">Objectif</span></div></aside><div class="body"><div class="side-note gray">scope / formal</div><h2>Objective</h2><div class="prose"><p>{{ objective }}</p></div></div></section>
<section class="project-section" id="fieldlog"><aside class="rail"><div class="num">03</div><div class="tri-stack"><span class="en">FIELD LOG</span><span class="jp">記録</span><span class="fr">Démarche</span></div></aside><div class="body"><h2>Protocol</h2><div class="log">{% for step in protocol %}<div class="log-item"><div class="log-id">LOG {{ loop.index | pad2 }}</div><div class="log-copy"><strong>{{ step.title }}</strong><p>{{ step.text }}</p></div></div>{% endfor %}</div></div></section>
{% set sectionNum = 4 %}{% if cases %}<section class="project-section"><aside class="rail"><div class="num">04</div><div class="tri-stack"><span class="en">INCIDENTS</span><span class="jp">診断</span><span class="fr">Cas de diagnostic</span></div></aside><div class="body">{{ mascotChip("diagnostic", "INCIDENT REVIEW") | safe }}<h2>Useful cases</h2><div class="case-grid">{% for c in cases %}<article class="case"><small>{{ c.label }}</small><h3>{{ c.title }}</h3><p>{{ c.text }}</p></article>{% endfor %}</div></div></section>{% set sectionNum = 5 %}{% endif %}
<section class="project-section" id="evidence"><aside class="rail"><div class="num">{{ sectionNum | pad2 }}</div><div class="tri-stack"><span class="en">EVIDENCE</span><span class="jp">証拠</span><span class="fr">Preuves</span></div></aside><div class="body">{{ mascotChip("diagnostic", "EVIDENCE / PROOF") | safe }}<h2>Evidence</h2><div class="evidence-grid">{% for item in evidence %}<div class="evidence{% if loop.first %} wide{% endif %}"><small>EVIDENCE {{ loop.index | pad2 }} / 証拠</small><strong>{{ item }}</strong></div>{% endfor %}</div><p class="evidence-caption">Ces emplacements sont destinés aux captures et photographies réelles du projet. La structure est déjà prête pour les intégrer sans modifier la mise en page.</p></div></section>
{% set sectionNum = sectionNum + 1 %}
<section class="project-section"><aside class="rail"><div class="num">{{ sectionNum | pad2 }}</div><div class="tri-stack"><span class="en">{% if is_current_state %}CURRENT STATE{% else %}OUTCOME{% endif %}</span><span class="jp">{% if is_current_state %}状態{% else %}結果{% endif %}</span><span class="fr">{{ state_label or "Résultat" }}</span></div></aside><div class="body"><h2>{% if is_current_state %}Current State{% else %}Outcome{% endif %}</h2><div class="{% if is_current_state %}current-state{% else %}outcome{% endif %}"><strong>{{ state_title or display }}</strong><p>{{ outcome }}</p></div></div></section>
{% set sectionNum = sectionNum + 1 %}
<section class="project-section"><aside class="rail"><div class="num">{{ sectionNum | pad2 }}</div><div class="tri-stack"><span class="en">LESSONS</span><span class="jp">学び</span><span class="fr">Enseignements</span></div></aside><div class="body"><h2>What stayed</h2><div class="lesson-list">{% for item in lessons %}<div class="lesson"><b>L{{ loop.index | pad2 }}</b><span>{{ item }}</span></div>{% endfor %}</div></div></section>
<nav class="nextbar"><a href="{{ prev.file }}"><small>← PREVIOUS UNIT</small><strong>{{ prev.name }}</strong></a><a href="{{ next.file }}"><small>NEXT UNIT →</small><strong>{{ next.name }}</strong></a></nav></main>
<footer class="footer"><div class="footer-main"><strong>UNIT {{ num }}<br>{{ display }}</strong><div class="project-footer-joke">{{ themeMark(theme) | safe }}<span><b>{{ footer_title }}</b><br>{{ footer_joke }}</span></div><div class="footer-languages"><span>FR / CONTENT</span><span>EN / UI</span><span class="jp">JP / 記号</span></div></div><div class="footer-side"><div>{{ category }}<br>{{ jp }} / TECHNICAL ARCHIVE</div><div>{{ site.revision }} / 2026</div></div></footer>
<script src="rrt4-safe.js"></script></body></html>